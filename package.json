  "keywords": [
    "nextjs",
    "react",
    "canvas",
    "ambient",
    "background",
    "animation",
    "effects",
    "fireflies",
    "snow",
    "confetti",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-waqar-uit/ambient-effects.git"
  },
  "homepage": "https://github.com/Muhammad-waqar-uit/ambient-effects#readme",
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/ambient-effects/ambient-effects/issues",
  "author": "",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
